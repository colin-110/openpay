<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openpay</groupId>
    <artifactId>openpay</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OpenPay</name>
    <description>Production-grade distributed payment gateway monorepo</description>

    <modules>
        <module>libs/common-observability</module>
        <module>libs/common-security</module>
        <module>libs/common-kafka</module>
        <module>libs/common-outbox</module>
        <module>services/gateway-service</module>
        <module>services/auth-service</module>
        <module>services/merchant-service</module>
        <module>services/payment-service</module>
        <module>services/provider-router-service</module>
        <module>services/webhook-service</module>
        <module>services/ledger-service</module>
        <module>services/settlement-service</module>
        <module>services/notification-service</module>
        <module>services/fraud-service</module>
        <module>services/mock-bank-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring.boot.version>3.5.4</spring.boot.version>
        <springdoc.version>2.8.9</springdoc.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!--
          docker-java negotiates an API version older than Docker Engine 29 accepts, so
          Testcontainers fails with a bare "Could not find a valid Docker environment".
          Pinning a supported version fixes it. 1.44 ships in Docker 25+ (2024); override with
          -Dtestcontainers.docker.api.version=... on an older daemon.
        -->
        <testcontainers.docker.api.version>1.44</testcontainers.docker.api.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
              This project imports the Spring Boot BOM rather than inheriting from
              spring-boot-starter-parent, and the repackage goal only gets a default execution from
              that parent. Without this block `mvn package` produced plain jars with no manifest
              main class and no dependencies: nothing that could actually be run or deployed. It
              went unnoticed because every local run used spring-boot:run, which never touches the
              packaged artifact.

              skip is true here and overridden to false in each service, so libraries stay plain
              jars and only the applications are repackaged.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Integration tests (*IT) run under failsafe during `verify`, not during `test`.
              They start a real PostgreSQL via Testcontainers, so `mvn test` stays runnable
              without Docker while `mvn verify` proves entities actually match the migrations.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                      Failsafe runs after package, and package now repackages each service into a
                      Spring Boot fat jar whose classes live under BOOT-INF/classes. Resolving the
                      module's own artifact from there leaves JUnit unable to discover anything,
                      which surfaces as "TestEngine with ID 'junit-jupiter' failed to discover
                      tests" rather than as a classpath error. Pointing at the plain output
                      directory keeps integration tests running against ordinary classes.
                    -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <systemPropertyVariables>
                        <api.version>${testcontainers.docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
