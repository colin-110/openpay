<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openpay</groupId>
    <artifactId>openpay</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OpenPay</name>
    <description>Production-grade distributed payment gateway monorepo</description>

    <modules>
        <module>libs/common-observability</module>
        <module>libs/common-security</module>
        <module>libs/common-kafka</module>
        <module>libs/common-outbox</module>
        <module>libs/common-audit</module>
        <module>libs/common-email</module>
        <module>services/gateway-service</module>
        <module>services/auth-service</module>
        <module>services/merchant-service</module>
        <module>services/payment-service</module>
        <module>services/provider-router-service</module>
        <module>services/webhook-service</module>
        <module>services/ledger-service</module>
        <module>services/settlement-service</module>
        <module>services/notification-service</module>
        <module>services/fraud-service</module>
        <module>services/mock-bank-service</module>
        <module>services/vault-service</module>
        <module>services/demo-storefront</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!--
          Pinned to the newest 3.5.x patch rather than the 4.x line: a scan found 30 known CVEs
          (5 critical, CVSS up to 9.8) in what 3.5.4's dependency-managed versions pulled in —
          tomcat-embed-core, spring-core, spring-expression, spring-data-commons, spring-kafka,
          jackson-core, kafka-clients. 3.5.16's own BOM already manages fixed versions of every
          one of them (tomcat.version=10.1.55, jackson-bom.version=2.21.4, kafka.version=3.9.2,
          confirmed by reading spring-boot-dependencies-3.5.16.pom directly), so the single
          version bump is the complete fix — no per-artifact overrides needed. Staying on 3.5.x
          avoids the migration risk a 4.x major bump would carry. See docs/SECURITY-AUDIT.md.
        -->
        <spring.boot.version>3.5.16</spring.boot.version>
        <springdoc.version>3.0.3</springdoc.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!--
          docker-java negotiates an API version older than Docker Engine 29 accepts, so
          Testcontainers fails with a bare "Could not find a valid Docker environment".
          Pinning a supported version fixes it. 1.44 ships in Docker 25+ (2024); override with
          -Dtestcontainers.docker.api.version=... on an older daemon.
        -->
        <testcontainers.docker.api.version>1.44</testcontainers.docker.api.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
              This project imports the Spring Boot BOM rather than inheriting from
              spring-boot-starter-parent, and the repackage goal only gets a default execution from
              that parent. Without this block `mvn package` produced plain jars with no manifest
              main class and no dependencies: nothing that could actually be run or deployed. It
              went unnoticed because every local run used spring-boot:run, which never touches the
              packaged artifact.

              skip is true here and overridden to false in each service, so libraries stay plain
              jars and only the applications are repackaged.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Integration tests (*IT) run under failsafe during `verify`, not during `test`.
              They start a real PostgreSQL via Testcontainers, so `mvn test` stays runnable
              without Docker while `mvn verify` proves entities actually match the migrations.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                      Failsafe runs after package, and package now repackages each service into a
                      Spring Boot fat jar whose classes live under BOOT-INF/classes. Resolving the
                      module's own artifact from there leaves JUnit unable to discover anything,
                      which surfaces as "TestEngine with ID 'junit-jupiter' failed to discover
                      tests" rather than as a classpath error. Pointing at the plain output
                      directory keeps integration tests running against ordinary classes.
                    -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <systemPropertyVariables>
                        <api.version>${testcontainers.docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Coverage, measured over both suites rather than just the unit tests.

              Separate destFiles and a merged report on purpose: most of what proves this platform
              works lives in the *IT tests — that a payment survives a real PostgreSQL, that a
              poison message reaches its DLQ — and a unit-tests-only number would report the
              best-tested parts of the codebase as the worst. `report-aggregate` in a dedicated
              module is the other way to do this; per-module reports were chosen because each
              service is independently deployable and a blended monorepo percentage would hide a
              service with no tests behind eleven that have them.

              Deliberately no `check` rule with a minimum. A threshold picked now, against no
              baseline, would either be low enough to pass everything (decoration) or high enough
              to fail the build on the first honest measurement (noise someone disables). Measure
              first, then set one that means something.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-unit</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-unit.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                        </configuration>
                    </execution>
                    <!--
                      Merge before reporting, so a class exercised only by an IT is not counted as
                      uncovered in a report drawn from the unit run alone.
                    -->
                    <execution>
                        <id>merge-all</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco-*.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report-all</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
